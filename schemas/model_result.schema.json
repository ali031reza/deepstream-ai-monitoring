{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/model_result.schema.json",
  "title": "Independent AI Model Result",
  "description": "One model's inference result for one video frame. Model A and Model B publish separate messages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "model_id",
    "source_id",
    "frame_id",
    "processed_at_utc",
    "gpu_id",
    "frame_width",
    "frame_height",
    "model_input_size",
    "detection_count",
    "detections",
    "timings_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "processed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "gpu_id": {
      "type": "integer",
      "minimum": 0
    },
    "frame_width": {
      "type": "integer",
      "minimum": 1
    },
    "frame_height": {
      "type": "integer",
      "minimum": 1
    },
    "model_input_size": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "detection_count": {
      "type": "integer",
      "minimum": 0
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "timings_ms": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
