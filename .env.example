# Copy to .env; never commit your real credentials.
APP_CONFIG_PATH=configs/config.yaml
# PROJECT_ROOT=/workspace
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RESULTS_CONSUMER_GROUP_ID=deepstream-results-processor
KAFKA_AUTO_OFFSET_RESET=earliest
INFERENCE_DEAD_LETTER_TOPIC=inference-dead-letter
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_NAME=ai_monitoring
DATABASE_USER=ai_app
DATABASE_PASSWORD=replace-with-a-local-secret
# Generate with openssl rand -hex 32 before starting Compose.
# OBJECT_STORE_PASSWORD=<generated local secret>
